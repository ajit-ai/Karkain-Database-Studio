func test_table_record_parse() {
    let rec = "users|id,name,score|1,alice,90;2,bob,80"
    let f = split(rec, "|")
    assert_eq(len(f), 3)
    assert_eq(f[0], "users")
    assert_eq(len(split(f[1], ",")), 3)
    assert_eq(len(split(f[2], ";")), 2)
}

func test_row_append_and_count() {
    let rows = "EMPTY"
    rows = "1,alice,90"
    rows = rows + ";" + "2,bob,80"
    rows = rows + ";" + "3,carol,95"
    let all = split(rows, ";")
    assert_eq(len(all), 3)
    assert_eq(len(split(all[0], ",")), 3)
    assert_eq(split(all[2], ",")[2], "95")
}

func test_column_count_validation() {
    let cols = "id,name,score"
    let values = "1,alice,90"
    assert_eq(len(split(cols, ",")), len(split(values, ",")))
    assert_eq(len(split("1,alice", ",")), 2)
}
